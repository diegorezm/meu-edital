{
  "name": "@meu-edital/api",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "lint": "eslint .",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "deploy:preview": "wrangler d1 migrations apply DB --remote --env preview && wrangler deploy --env preview"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.22",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@meu-edital/agent-context": "workspace:*",
    "@meu-edital/db": "workspace:*",
    "@meu-edital/domain": "workspace:*",
    "@meu-edital/sync": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@pushforge/builder": "2.0.5",
    "agents": "0.33.0",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "wrangler": "^4.161.0"
  }
}
