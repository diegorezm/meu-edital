// Worker único: API em /api/* e o app web (apps/web/dist) como static assets,
// na mesma origem. Ambientes: o topo é o desenvolvimento local; `preview` e
// `production` são publicados com `wrangler deploy --env <nome>`.
// Bindings e vars não são herdados: repita em cada ambiente.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meu-edital",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  // Exigido pelo CIMD do OAuth (o ChatGPT se identifica por uma URL): o fetch
  // do Worker só alcança endereços públicos.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  // Um Durable Object por usuário para os avisos de sync em tempo real.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
  // Concessões e tokens do OAuth do Oráculo (MCP).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "VAPID_PRIVATE_KEY"] },
  "vars": {
    // Local: o Vite (5173) faz proxy de /api para o Worker; o Worker também
    // serve o build direto em 8787. Os dois endereços são confiáveis.
    "APP_URL": "http://localhost:5173",
    "EXTRA_ORIGINS": "http://localhost:8787",
    "EMAIL_MODE": "log",
    // open: qualquer um cria conta; waitlist: só a lista de espera.
    "SIGNUP_MODE": "open",
    "SITE_URL": "http://localhost:4321",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "VAPID_PUBLIC_KEY": "BNXF45Si-7YxbCtU3FpFCVh0NrytWVidfYJfs79hzUg2r52PjxODFYI3m3PU7JBPGNxXRYAX8P-VHTGW68ENCdI"
  },
  // Lembrete diário de revisões vencidas por Web Push (11h UTC = 8h em Brasília).
  "triggers": { "crons": ["0 11 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meu-edital-preview",
      "database_id": "50183b85-4528-46e9-9fd7-e7d425158118",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "env": {
    "preview": {
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "38022bc855ef4ebc8275f30e05725d88" }],
      "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "VAPID_PRIVATE_KEY"] },
      "vars": {
        "APP_URL": "https://meu-edital-preview.diegommrez12.workers.dev",
        "SIGNUP_MODE": "open",
        "SITE_URL": "https://meu-edital-site-preview.diegommrez12.workers.dev",
        "EXTRA_ORIGINS": "",
        "EMAIL_MODE": "log",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "VAPID_PUBLIC_KEY": "BJb_UbQ9nkT_s8TjApmlswwpJutJXucjgnjYdfbpC4U9eNusa-G1Re_RpUalNhJUnHJW2AqdyXOUAJVXWunlbCU"
      },
      "triggers": { "crons": ["0 11 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "meu-edital-preview",
          "database_id": "50183b85-4528-46e9-9fd7-e7d425158118",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1011", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "1012", "simple": { "limit": 300, "period": 60 } }
      ]
    },
    "production": {
      "name": "meu-edital",
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ca2ce7e92fea4642ba17277e40d98072" }],
      "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "VAPID_PRIVATE_KEY"] },
      "vars": {
        "APP_URL": "https://meu-edital.diegommrez12.workers.dev",
        "SIGNUP_MODE": "waitlist",
        "SITE_URL": "https://meu-edital-site.diegommrez12.workers.dev",
        "EXTRA_ORIGINS": "",
        "EMAIL_MODE": "log",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF_DhmIY7Yp3ZNGq",
        "VAPID_PUBLIC_KEY": "BLcdxrhtGvlwULgw06k79-NfCgu7heiOB0ZwMfnKqlcnrENvR0DodAxZhyDZNGMNwo4d2UbreFWSS0KuL3Ciras"
      },
      "triggers": { "crons": ["0 11 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "meu-edital-production",
          "database_id": "c0b51811-4533-4359-ae45-58bcf83caa24",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1021", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "1022", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
