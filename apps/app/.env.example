# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API). Sem essas variáveis o app roda no modo local, sem conta.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Endereço do site de divulgação (apps/site). Na web, "Voltar ao site" leva para ele.
EXPO_PUBLIC_SITE_URL=https://meu-edital.pages.dev
