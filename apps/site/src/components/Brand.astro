---
import { mark } from "@meu-edital/brand";

type Props = { large?: boolean };
const { large = false } = Astro.props;
const { frame } = mark;
const size = large ? 38 : 32;
---

<a href="/" class="brand" aria-label="Meu Edital, página inicial">
  <svg width={size} height={size} viewBox={mark.viewBox} aria-hidden="true">
    <rect width="120" height="120" rx="27" fill="var(--bg)"></rect>
    <rect
      x={frame.x}
      y={frame.y}
      width={frame.size}
      height={frame.size}
      rx={frame.radius}
      fill="none"
      stroke="var(--ink)"
      stroke-width={frame.stroke}></rect>
    <path d={mark.highlight} fill="var(--highlight)"></path>
    <path d={mark.letter.d} transform={mark.letter.transform} fill="var(--ink)"
    ></path>
    <circle cx={mark.dot.cx} cy={mark.dot.cy} r={mark.dot.r} fill="var(--danger)"
    ></circle>
  </svg>
  <span class="logo">meu edital<span class="dot">.</span></span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .logo {
    font-family: "Newsreader", Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
  }
  .dot {
    color: var(--danger);
  }
</style>
