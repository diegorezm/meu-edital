---
type Props = { inverted?: boolean };
const { inverted = false } = Astro.props;
---

<a href="/" class="brand" aria-label="Meu Edital, página inicial">
  <span class:list={["mark", { inverted }]}>m.</span>
  <span class="logo">meu edital<span class="dot">.</span></span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .mark {
    width: 36px;
    height: 36px;
    border-radius: 13px;
    background: var(--lavender);
    color: var(--dark);
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -1.5px;
  }
  .mark.inverted {
    background: var(--dark);
    color: var(--lavender);
  }
  .logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.9px;
    color: var(--text);
  }
  .dot {
    color: #8b75db;
  }
</style>
