{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@features/*": ["./src/features/*"],
      "@global/*": ["./src/global/*"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
