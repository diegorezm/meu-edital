{
  "name": "meu-edital",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@meu-edital/app",
    "web": "npm run web --workspace=@meu-edital/app",
    "android": "npm run android --workspace=@meu-edital/app",
    "build:web": "turbo run build:web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "deploy:web": "npm run deploy:web --workspace=@meu-edital/app",
    "deploy:web:preview": "npm run deploy:web:preview --workspace=@meu-edital/app"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
