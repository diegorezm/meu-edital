{
  "name": "meu-edital",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@meu-edital/api --filter=@meu-edital/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "deploy:preview": "turbo run build --filter=@meu-edital/web && bun run --cwd apps/api deploy:preview",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
